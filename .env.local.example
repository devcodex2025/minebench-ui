################################################################################
# MineBench UI - Environment Configuration Template
#
# IMPORTANT: Copy this file to .env.local and fill in your actual values
# NEVER commit the .env.local file to Git!
#
# This file contains EXAMPLES ONLY. For production, generate your own secrets.
################################################################################

# ===== Supabase Configuration =====
# Get from: https://app.supabase.com -> Settings -> API
# NEXT_PUBLIC_* variables ARE visible in the browser - only use anon keys!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key for server-side operations ONLY
# Do NOT expose this in browser/client-side code!
# Only used in API routes (pages/api/*)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server-side verification for JWTs issued by MineBench Backend
# Must match the backend JWT_SECRET and be at least 32 bytes
JWT_SECRET=your_shared_backend_jwt_secret_here

# ===== Solana Configuration =====
# Premium RPC URLs for better performance
# Free options: https://api.mainnet-beta.solana.com
# Paid options: Helius, QuickNode, Alchemy, etc.
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_alchemy_key

# ===== Backend API Configuration =====
# URL of your MineBench Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001
# For production, use your actual domain
# NEXT_PUBLIC_API_URL=https://api.minebench.com

# ===== GitHub Configuration =====
# Server-only GitHub token for API routes that fetch release metadata.
# Do not expose this through NEXT_PUBLIC_* variables.
# Create at: https://github.com/settings/tokens
# Scope should be limited to the minimum required.
GITHUB_SERVER_TOKEN=your_server_side_github_token_here

# ===== Analytics Configuration (Optional) =====
# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Google Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# ===== Feature Flags =====
# Enable/disable features in UI
NEXT_PUBLIC_ENABLE_STATS_PAGE=true
NEXT_PUBLIC_ENABLE_WALLET_CONNECT=true
NEXT_PUBLIC_ENABLE_PRICE_ALERTS=false

# ===== Development Configuration =====
# Set to true for local development with more verbose logging
NEXT_PUBLIC_DEBUG_MODE=false
